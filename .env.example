# ==============================================================================
# Email Automation & Reminder System - Environment Configuration
# ==============================================================================
# IMPORTANT: Copy this file to '.env' and fill in your real credentials.
# NEVER commit your '.env' file or passwords to GitHub!
# ==============================================================================

# Operational Mode: True = Virtual Simulation (zero risk, tests whole pipeline)
#                   False = Live SMTP Dispatch (sends real emails)
DRY_RUN=True

# SMTP Server Host and Port
# Gmail: smtp.gmail.com (Port 587 with STARTTLS or 465 with SSL)
# Outlook/Office365: smtp.office365.com (Port 587)
# Yahoo: smtp.mail.yahoo.com (Port 587 or 465)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=False

# SMTP Credentials
# For Gmail: Use an App Password (NOT your regular Google password)
# Visit: https://myaccount.google.com/apppasswords
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Display Name for Outgoing Emails
SENDER_NAME=Enterprise Operations Automated Dispatcher

# Retry & Timeout Configuration
SMTP_TIMEOUT=15
MAX_RETRIES=3
RETRY_DELAY=2
